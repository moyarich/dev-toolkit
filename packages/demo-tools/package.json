{
  "name": "@moyarich/demo-tools",
  "version": "0.0.0",
  "description": "Strategy-first tooling for creating automated demos, screenshots, and recordings.",
  "type": "module",
  "bin": {
    "demo": "./bin/demo.mjs",
    "demo-strategy": "./bin/demo-strategy.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./strategy": "./src/strategy/index.ts",
    "./utils": "./src/utils/index.ts",
    "./vscode": "./src/vscode/index.ts",
    "./capture": "./src/capture/index.ts",
    "./browser": "./src/browser/index.ts",
    "./components": "./src/components/index.ts",
    "./generate": "./src/generate/index.ts"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" vite.config.ts && prettier --check \"src/**/*.{ts,cjs}\" \"tests/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\"",
    "lint:eslint": "eslint \"src/**/*.ts\" vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,cjs}\" \"tests/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,cjs}\" \"tests/**/*.mjs\" \"vite.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\""
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@vscode/test-electron": ">=2.5.0",
    "playwright-core": ">=1.55.0"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@moyarich/web-components": "0.0.0",
    "chalk": "^6.0.1",
    "commander": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/demo-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^7.1.7",
    "typescript": "^5.9.3",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.1"
  },
  "license": "MIT"
}
