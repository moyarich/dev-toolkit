{
  "name": "@moyarich/demo-tools",
  "version": "0.1.0",
  "description": "Strategy-first tooling for creating automated demos, screenshots, and recordings.",
  "type": "module",
  "bin": {
    "demo": "./dist/bin/demo.mjs",
    "demo-strategy": "./dist/bin/demo-strategy.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./strategy": "./dist/strategy.mjs",
    "./utils": "./dist/utils.mjs",
    "./vscode": "./dist/vscode.mjs",
    "./capture": "./dist/capture.mjs",
    "./browser": "./dist/browser.mjs",
    "./components": "./dist/components.mjs",
    "./generate": "./dist/generate.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" vite.config.ts vite.lib.config.ts && prettier --check \"src/**/*.{ts,cjs}\" \"tests/**/*.ts\" \"vite.config.ts\" \"vite.lib.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\"",
    "lint:eslint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" vite.config.ts vite.lib.config.ts",
    "format": "prettier --write \"src/**/*.{ts,cjs}\" \"tests/**/*.ts\" \"vite.config.ts\" \"vite.lib.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,cjs}\" \"tests/**/*.ts\" \"vite.config.ts\" \"vite.lib.config.ts\" \"eslint.config.mjs\" \"prettier.config.mjs\" \"package.json\""
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "playwright-core": ">=1.63.0",
    "chalk": ">=6.0.1",
    "commander": ">=15.0.0",
    "@inquirer/prompts": ">=8.7.2"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@moyarich/web-components": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/demo-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.1.0"
  },
  "license": "MIT"
}
