{
  "name": "@moyarich/demo-tools",
  "version": "0.0.0",
  "description": "Strategy-first tooling for creating automated demos, screenshots, and recordings.",
  "type": "module",
  "bin": {
    "demo": "./bin/demo.mjs",
    "demo-strategy": "./bin/demo-strategy.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./strategy": "./src/strategy.mjs",
    "./utils": "./src/utils/index.mjs",
    "./vscode": "./src/vscode/index.mjs",
    "./capture": "./src/capture/index.mjs",
    "./browser": "./src/browser/index.mjs",
    "./components": "./src/components/index.mjs",
    "./generate": "./src/generate/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.mts",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@vscode/test-electron": ">=2.5.0",
    "playwright-core": ">=1.55.0"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@moyarich/web-components": "0.0.0",
    "chalk": "^6.0.1",
    "commander": "^14.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/demo-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^7.1.7"
  }
}
