{
  "name": "@moyarich/workspace-tools",
  "version": "0.1.2",
  "description": "Reusable workspace release and publishing tools.",
  "type": "module",
  "bin": {
    "workspace-release": "./bin/workspace-release.mjs",
    "workspace-publish": "./bin/workspace-publish.mjs",
    "workspace-dependency-check": "./bin/workspace-dependency-check.mjs",
    "workspace-package-lock": "./bin/workspace-package-lock.mjs",
    "discover-packages": "./bin/discover-packages.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.1",
    "commander": "^15.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/workspace-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.1.0"
  },
  "license": "MIT"
}
