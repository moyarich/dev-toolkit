    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/vs-code-ext-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^7.1.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
