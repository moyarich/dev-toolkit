{
  "name": "@moyarich/vs-code-ext-tools",
  "version": "0.1.0",
  "description": "Reusable vs-code extension tools.",
  "type": "module",
  "bin": {
    "vs-code-publish": "./bin/vs-code-publish.mjs",
    "run-extension-dev": "./bin/run-extension-dev.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^6.0.1",
    "commander": "^14.0.3"
  },
  "repository": {
