{
  "name": "@moyarich/vs-code-ext-tools",
  "version": "0.1.0",
  "description": "Reusable vs-code extension tools.",
  "type": "module",
  "bin": {
    "vs-code-publish": "./dist/bin/vs-code-publish.mjs",
    "run-extension-dev": "./dist/bin/run-extension-dev.mjs",
    "run-vscode-tests": "./dist/bin/run-vscode-tests.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/vs-code-ext-tools"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.1.0"
  },
  "license": "MIT"
}
