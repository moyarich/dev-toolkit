{
  "name": "@moyarich/auto-glow-md",
  "version": "0.1.0",
  "description": "Oh My Zsh plugin and PTY CLI that automatically renders Markdown terminal output with Glow.",
  "type": "module",
  "bin": {
    "moyarich-auto-glow-md": "./bin/moyarich-auto-glow-md.mjs"
  },
  "files": ["bin", "plugin", "src", "docs", "README.md"],
  "engines": {"node": ">=24"},
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run test/markdown-terminal-coverage",
    "typecheck": "tsc -p tsconfig.json",
    "checks": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/moyarich-auto-glow-md"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT"
}
