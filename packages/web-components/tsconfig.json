{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.d.ts"]
}
