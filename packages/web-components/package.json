{
  "name": "@moyarich/web-components",
  "version": "0.0.0",
  "description": "Reusable web components for demos and developer tooling.",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./caption": "./dist/caption.mjs",
    "./caption/element": "./dist/caption-element.mjs",
    "./cursor-overlay": "./dist/cursor-overlay.mjs",
    "./cursor-overlay/element": "./dist/cursor-overlay-element.mjs",
    "./magnifier-cursor-overlay": "./dist/magnifier-cursor-overlay.mjs",
    "./magnifier-cursor-overlay/element": "./dist/magnifier-cursor-overlay-element.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "node --check src/index.mjs && node --check src/caption/caption-overlay.mjs && node --check src/cursor-overlay/cursor-overlay-element.mjs && node --check src/magnifier-cursor-overlay/element.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/web-components"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT"
}
