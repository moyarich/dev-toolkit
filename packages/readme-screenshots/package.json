{
  "name": "@moyarich/readme-screenshots",
  "version": "0.0.1",
  "description": "Reusable Playwright README screenshot generator.",
  "type": "module",
  "bin": {
    "readme-screenshots": "./bin/readme-screenshots.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.63.0",
    "playwright-core": ">=1.63.0"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/readme-screenshots"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.0.1"
  },
  "license": "MIT"
}
