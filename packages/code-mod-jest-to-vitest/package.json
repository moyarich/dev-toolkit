{
  "name": "@moyarich/code-mod-jest-to-vitest",
  "version": "0.1.0",
  "description": "Self-contained Jest to Vitest codemod.",
  "type": "module",
  "bin": {
    "jest-to-vitest": "./bin/jest-to-vitest.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "docs",
    ".codemodrc.json",
    "README.md",
    "codemod.yaml",
    "workflow.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "test": "npx codemod jssg test scripts/jest-to-vitest.ts --language typescript",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "npx codemod workflow validate -w workflow.yaml",
    "jest-to-vitest": "node ./bin/jest-to-vitest.mjs",
    "audit": "node ./bin/jest-to-vitest.mjs --audit-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/dev-toolkit.git",
    "directory": "packages/code-mod-jest-to-vitest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "0.1.0",
    "@codemod.com/jssg-types": "^1.6.3"
  },
  "license": "MIT"
}
