{
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@moyarich/demo-tools": ["./packages/demo-tools/src/index.ts"]
    }
  },
  "include": [
    "tests/*.test.ts",
    "tests/workflows/*.test.ts",
    "tests/packages/**/*.ts",
    "tests/playground/*.test.ts",
    "demo/strategies/**/*.ts"
  ]
}
