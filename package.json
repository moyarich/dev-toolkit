{
  "name": "@moyarich/dev-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Shared development tooling and reusable GitHub workflows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "demo",
    "demo:list": "demo list",
    "test:playground": "node --test tests/playground/*.test.mjs",
    "package-lock:update": "npm install --package-lock-only --include=optional"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commander": "^14.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.5",
    "@esbuild/linux-x64": "0.28.2"
  }
}
