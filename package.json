{
  "name": "@moyarich/dev-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Shared development tooling and reusable GitHub workflows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/cli.test.mjs && npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "demo",
    "demo:list": "demo list",
    "test:playground": "node --test tests/playground/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commander": "^14.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.0.0"
  }
}
