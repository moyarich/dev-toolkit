{
  "name": "@moyarich/dev-toolkit",
  "private": true,
  "version": "0.0.0",
  "description": "Shared development tooling and reusable GitHub workflows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "demo",
    "demo:list": "demo list",
    "test:playground": "node --test tests/playground/*.test.mjs",
    "package-lock:update": "npm install --package-lock-only --include=optional"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commander": "^14.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.5",
    "@esbuild/linux-x64": "0.28.2"
  }
}
